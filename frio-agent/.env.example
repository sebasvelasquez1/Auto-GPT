# Frío config (env vars are prefixed FRIO_). Copy to .env and fill in.

# --- Targeting ---
FRIO_NICHE=spirituality
FRIO_SEED_BRANDS=Spiritual Gangster
FRIO_PIPELINE=pod            # pod | dropship

# --- Gating (keep OFF until approved; gated capabilities stay hidden) ---
FRIO_CREATION_ENABLED=0      # spend on AI-UGC video rendering
FRIO_SELLER_APPROVED=0       # TikTok Shop seller + app approved
FRIO_ADS_LIVE_ENABLED=0      # live ad spend

# --- Spend caps (hard ceilings) ---
FRIO_DAILY_SPEND_CAP_USD=0
FRIO_PER_CAMPAIGN_SPEND_CAP_USD=0
FRIO_PER_CLIP_COST_CAP_USD=0     # per AI-UGC video clip
FRIO_PER_IMAGE_COST_CAP_USD=0    # per AI-UGC image (carousel slide)

# --- Data ---
FRIO_DATABASE_URL=sqlite:///frio.db

# --- Credentials (optional) ---
# FRIO_ANTHROPIC_API_KEY=
# FRIO_SIMILARWEB_API_KEY=
# FRIO_FASTMOSS_API_KEY=
# FRIO_PRINTFUL_API_KEY=
# FRIO_FAL_API_KEY=          # video gen: one key -> Veo 3.1 / Kling / Runway via fal.ai
# FRIO_HIGGSFIELD_API_KEY=   # video+image (carousels): Nano Banana/Soul/Seedance via MCP
# FRIO_ADTEST_API_KEY=       # optional third-party predictive pre-score (connector shape only)
# FRIO_VIDEO_PROVIDER=veo            # veo | kling | runway | prizmad | arcads
# FRIO_IMAGE_PROVIDER=nano_banana    # nano_banana | soul | flux | gpt_image
# TikTok Shop (custom app, in-house seller). From Partner Center after app review:
# FRIO_TIKTOK_SHOP_APP_KEY=
# FRIO_TIKTOK_SHOP_APP_SECRET=
# FRIO_TIKTOK_SHOP_ACCESS_TOKEN=      # from the OAuth auth_code exchange (per shop)
# FRIO_TIKTOK_SHOP_REFRESH_TOKEN=
# FRIO_TIKTOK_SHOP_CIPHER=            # identifies the specific shop in requests
# FRIO_TIKTOK_ADS_API_KEY=
